# Otosanayide Panel API. Gercek degerler yalniz sunucudaki .env'de durur; bu dosyada sir yoktur.
APP_NAME="Otosanayide Panel API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Veritabani: ana API ile AYNI MySQL 8.4 veritabani. Panel kendi tablolarini panel_* adiyla
# ve ayri migration defteriyle (panel_migrations) yonetir. On kosul: ana API migration'lari uygulanmis olmali.
# Bu depo veritabanina baglanmaz; degerler sunucuda girilir. Port K173-A1 geregi 33066.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=33066
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_MIGRATIONS_TABLE=panel_migrations
MYSQL_ATTR_SSL_CA=

# Paylasilan cache/jobs tablolari: panel anahtarlari onekle ayrilir; kuyruk isleri ana API isci tarafindan da islenebilir.
SESSION_DRIVER=array
CACHE_STORE=database
CACHE_PREFIX=otosanayide-panel-
QUEUE_CONNECTION=database

# --- Panel ---
# Panel on yuzunun tek origin'i (https, sonda / yok). Bos: tarayici CORS almaz.
PANEL_WEB_ORIGIN=
# Virgulle IP/CIDR; bos: genel kisit yok (uyeye ozel liste yine uygulanir).
PANEL_IP_ALLOWLIST=
# IP ozeti HMAC anahtari (bos: APP_KEY). Ham IP yazilmaz.
PANEL_IP_HASH_KEY=
# Yenileme cerezi alan adi (bos: yalniz API host'u); yerel gelistirmede http icin PANEL_COOKIE_SECURE=false.
PANEL_COOKIE_DOMAIN=
PANEL_COOKIE_SECURE=true
# Oneri sureleri (kullanici kabulu bekler).
PANEL_ACCESS_TTL_MINUTES=15
PANEL_IDLE_MINUTES=30
PANEL_ABSOLUTE_HOURS=12
PANEL_MFA_ENROLLMENT_HOURS=72
PANEL_LOGIN_PER_MINUTE=5
PANEL_MEMBER_PER_MINUTE=120
# Zamanlanmis isler varsayilan kapali; once kuru calisma incelenir.
PANEL_HOUSEKEEPING_ENABLED=false
PANEL_WORK_ITEMS_SYNC_ENABLED=false
PANEL_STATS_SNAPSHOT_ENABLED=false
# Vendor edilen cekirdek kontrolu (panel:core-check) icin ana API dizini.
PANEL_CORE_SOURCE=../otosanayide-api

# --- Ana API ile AYNI olmasi gereken degerler ---
# Panel, ana API'nin alan cekirdegini kullanir; bayrak ve depolama ayarlari farkli olursa panel karari ile
# ana API davranisi ayrisir. Asagidakileri sunucudaki ana API .env'inden aynen kopyalayin.
TRUSTED_PROXIES=
PUBLIC_WEB_ORIGIN=
FILESYSTEM_DISK=local
DATA_REQUESTS_ENABLED=false
REVIEW_PHOTOS_ENABLED=false
BUSINESS_PHOTOS_ENABLED=false
CLAIM_EVIDENCE_ENABLED=false
GOOGLE_PLACES_ENABLED=false
AI_MODERATION_ENABLED=false
AD_SERVING_ENABLED=false
AD_METRICS_ENABLED=false
AD_RESERVATIONS_ENABLED=false
BRAND_ORDERS_ENABLED=false
BRAND_METRICS_ENABLED=false
BRAND_CANCELLATIONS_ENABLED=false
BRAND_RESERVATIONS_ENABLED=false
BRAND_REFUND_REVIEW_ENABLED=false
BRAND_PREVIEW_ENABLED=false
BRAND_MEDIA_ENABLED=false
BRAND_ACCEPTANCE_ENABLED=false
BRAND_SERVING_ENABLED=false
PAYMENTS_ENABLED=false
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
MODERATION_EXTRA_TERMS=
BRAND_METRICS_SECRET=
BRAND_MEDIA_DISK=
PAYMENT_PROVIDER_NAME=
PAYMENT_MERCHANT_ID=
PAYMENT_GATEWAY_ORIGIN=
PAYMENT_GATEWAY_TOKEN=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_ORIGIN=
PAYMENT_CHECKOUT_ORIGINS=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PRIVATE_ROOT=
R2_BRAND_ROOT=
R2_PUBLIC_ROOT=
MEDIA_CDN_DISK=
MEDIA_CDN_URL=
MEDIA_CDN_MAX_AGE=3600
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=

# Yalniz yerel/test seeder'lari icin (depoya deger yazilmaz):
# SEED_PANEL_ADMIN_EMAIL=  SEED_PANEL_ADMIN_NAME=  LOCAL_PANEL_PASSWORD=
